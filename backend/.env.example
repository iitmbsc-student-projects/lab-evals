# Example .env for Lab Evaluation Application
# Copy to .env and fill with your secrets for local development

# Database connection URL
DATABASE_URL=sqlite:///./dev.db

# JWT secret key for signing tokens
JWT_SECRET=your-jwt-secret

# JWT algorithm (e.g., HS256)
JWT_ALGORITHM=HS256

# JWT expiry in minutes
JWT_EXPIRES_MINUTES=60

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Environment (development or production)
ENV=development

# Automatically create admin user on startup -- details
ADMIN_EMAIL=me@example.com
ADMIN_NAME=Admin

FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Production (Cloud Run) wiring -- for reference; not used locally.
#
# Cloud Run injects these via --set-secrets and --set-env-vars. See
# deploy/SETUP.md for the exact secret names and gcloud commands.
#
#   Secret Manager (--set-secrets)
#     JWT_SECRET        <- jwt-secret:latest
#     GOOGLE_CLIENT_ID  <- google-client-id:latest
#     DATABASE_URL      <- database-url:latest
#         (format: postgresql+psycopg://USER:PASS@/DB
#          ?host=/cloudsql/PROJECT:asia-south1:lab-evals-db)
#
#   Plain env (--set-env-vars)
#     ENV=production
#     JWT_ALGORITHM=HS256
#     JWT_EXPIRES_MINUTES=60
#     ADMIN_EMAIL=...
#     ADMIN_NAME=...
#     FRONTEND_ORIGIN=https://lab-evals.web.app
# ---------------------------------------------------------------------------
